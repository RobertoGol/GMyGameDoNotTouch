  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\Projects\Game_Project\build_verify_ninja\external\glfw\src && "C:\Program Files\CMake\bin\cmake-gui.exe" -SD:\Projects\Game_Project -BD:\Projects\Game_Project\build_verify_ninja"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build external\glfw\src\edit_cache: phony external\glfw\src\CMakeFiles\edit_cache.util


#############################################
# Utility command for rebuild_cache

build external\glfw\src\CMakeFiles\rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D D:\Projects\Game_Project\build_verify_ninja\external\glfw\src && "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -SD:\Projects\Game_Project -BD:\Projects\Game_Project\build_verify_ninja"
